{
  "name": "@brikx/extractor-cli",
  "version": "0.1.0",
  "description": "CLI tool for Brikx document extraction",
  "type": "module",
  "bin": {
    "brikx-extract": "./dist/bin/brikx-extract.js"
  },
  "scripts": {
